        "@vitest/coverage-v8": "^4.1.0",
        "jsdom": "^28.1.0",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.56.0",
        "phaser3spectorjs": "^0.0.8",
        "sass": "^1.98.0",
        "typescript": "^5.9",
        "vite": "^8.0.0",
        "vitest": "^4.1.0",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.10.1",
